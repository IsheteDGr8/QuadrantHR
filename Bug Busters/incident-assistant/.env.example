# Optional — defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./incident_assistant.db

# Required for follow-up question generation. Without these, POST /incident
# still works end-to-end (retrieval + ticket creation), it just returns
# status "error" instead of "pending_review" — useful for testing the rest
# of the flow without an LLM key.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
